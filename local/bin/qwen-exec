#!/bin/sh
# Qwen executor via local LM Studio (OpenAI-compatible endpoint)
export OPENAI_BASE_URL="http://localhost:1234/v1"
export OPENAI_API_KEY="lm-studio"          # any non-empty value; LM Studio ignores it
export OPENAI_MODEL="${OPENAI_MODEL:-qwen3.5-9b-polaris-highiq-instruct}"
# Keep the configured local default, but honor an explicit model override.
command -v qwen >/dev/null 2>&1 || {
  echo "qwen-exec: qwen is not installed or not on PATH" >&2
  exit 127
}
exec qwen "$@"
