# OS
.DS_Store

# Credentials & secrets
.credentials.json
**/.credentials.json
**/hosts.yml
**/*token*
**/*secret*
**/*password*
**/*credentials*

# Claude runtime data
claude/.claude/history.jsonl
claude/.claude/backups/
claude/.claude/cache/
claude/.claude/file-history/
claude/.claude/projects/
claude/.claude/sessions/
claude/.claude/session-env/
claude/.claude/shell-snapshots/
claude/.claude/tasks/
claude/.claude/plans/
claude/.claude/paste-cache/
claude/.claude/ide/
claude/.claude/plugins/

# New agent packages contain reviewed instructions only, never live client state.
codex/.codex/*
!codex/.codex/INSTRUCTIONS.md
!codex/.codex/AGENTS.md
gemini/.gemini/*
!gemini/.gemini/GEMINI.md
qwen/.qwen/*
!qwen/.qwen/QWEN.md
cursor/.cursor/*
!cursor/.cursor/rules/
roo/.roo/*
!roo/.roo/rules/

# Karabiner runtime
karabiner/.config/karabiner/assets/
karabiner/.config/karabiner/automatic_backups/

# tmux plugins (installed by TPM)
tmux/.config/tmux/plugins/
.DS_Store
